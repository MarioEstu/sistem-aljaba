# ============================================
# Catalog Aljaba — Backend Environment
# ============================================
# Copia este archivo como ".env" y completa los valores reales.
# NUNCA commitees el archivo ".env" al repositorio.

# Base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/catalog_aljaba?schema=public"

# JWT — Usa una cadena larga y aleatoria. Genera una con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV=development

# S3 / DigitalOcean Spaces (configurar al conectar storage)
S3_BUCKET_NAME=catalog-aljaba-dev
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS — origen del frontend
CORS_ORIGIN=http://localhost:3000

# Puppeteer / Generacion de PDF
# En desarrollo local (Windows/Mac) deja vacio: Puppeteer usa su propio Chrome descargado.
# En Linux/CI/Docker sin GUI, apunta al ejecutable de Chromium instalado, p.ej.:
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_EXECUTABLE_PATH=
